# =============================================================================
# Gestion Liste de Présence – Commission Nationale Formation
# Copiez ce fichier en .env (ou saisissez ces variables dans Dockploy).
# Ne commitez jamais le fichier .env.
# =============================================================================

# --- Domaines ---
# Les domaines se déclarent dans Dockploy (onglet Domains du service « frontend », port 3000),
# pas ici. L'application fonctionne sur n'importe quel domaine (même origine pour la page et l'API).
# Facultatif : origines supplémentaires autorisées à appeler l'API depuis un autre domaine (CORS),
# séparées par des virgules. Inutile dans le fonctionnement normal.
PUBLIC_URLS=

# --- PostgreSQL ---
POSTGRES_DB=cnap_attendance
POSTGRES_USER=cnap
# Générer par exemple avec : openssl rand -base64 24
POSTGRES_PASSWORD=changez-moi

# --- JWT (32 caractères minimum) ---
# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-de-48-caracteres
# Cookies « Secure » (HTTPS). Laisser à true derrière Cloudflare.
COOKIE_SECURE=true

# --- Compte administrateur ---
# Créé au premier démarrage s'il n'existe aucun administrateur.
# Le mot de passe devra être changé à la première connexion.
# 8 caractères minimum avec majuscule, minuscule et chiffre.
ADMIN_EMAIL=admin@rotary-district9101.org
ADMIN_PASSWORD=ChangezMoi2026

# Réinitialisation forcée (mot de passe oublié, compte verrouillé ou désactivé) :
#   1. ADMIN_RESET=true, ADMIN_EMAIL = compte à débloquer, ADMIN_PASSWORD = mot de passe provisoire ;
#   2. redéployer : le compte est créé s'il n'existe pas, sinon son mot de passe est remplacé,
#      il est réactivé, déverrouillé, remis Administrateur et ses sessions ouvertes sont fermées ;
#   3. se connecter avec le mot de passe provisoire (changement imposé), puis repasser ADMIN_RESET=false.
# Par sécurité, la réinitialisation n'est appliquée qu'une fois par valeur de ADMIN_PASSWORD :
# un redémarrage avec ADMIN_RESET=true oublié n'écrase pas le nouveau mot de passe choisi.
ADMIN_RESET=false

# Crée un club de démonstration, un séminaire actif et une session active si les tables sont vides.
SEED_DONNEES_DEMO=true

# Limite de requêtes par minute et par IP sur la page de scan publique.
# Garder une valeur large : les participants partagent souvent la même IP (Wi-Fi, opérateur mobile).
RATE_LIMIT_PUBLIC_PAR_MINUTE=300

# --- SMTP initial (facultatif) ---
# Repris en base au premier démarrage uniquement ; ensuite, modifiable dans Paramètres > Configuration email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Commission Nationale Formation
SMTP_TLS=true
